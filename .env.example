# Frontend Stripe config (public key only)
# Get this from Stripe Dashboard -> Developers -> API keys -> Publishable key
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_replace_with_matching_sandbox_key
# Must match the backend merchant and STRIPE_MODE. Never put sk_* keys here.

# Optional: override API base URL in production deployments
# Example: https://easy-shop-server-wldr.onrender.com/api/v1
VITE_API_BASE_URL=

# Optional browser-only Google key, restricted by HTTP referrer.
# Enable Maps JavaScript API, Routes API and Places API (New) with billing.
# Never put the backend Google API key here.
VITE_GOOGLE_MAPS_BROWSER_KEY=

# Optional: runtime maintenance mode endpoint used by admin dashboard ON/OFF toggle
# Defaults:
# - VITE_MAINTENANCE_MODE_PATH=/settings/maintenance
# - VITE_MAINTENANCE_MODE_METHOD=PUT
VITE_MAINTENANCE_MODE_PATH=/settings/maintenance
VITE_MAINTENANCE_MODE_METHOD=PUT
